{
  "name": "maven-packager",
  "version": "0.1.0",
  "description": "跨 repo 一鍵打包工具（讀取 Maven settings.xml profile，執行 mvn -P{profile}）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "author": "Charlie Tsai",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1"
  },
  "build": {
    "appId": "com.benq.maven-packager",
    "productName": "Maven Packager",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "repos.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Maven-Packager.exe"
    }
  }
}
